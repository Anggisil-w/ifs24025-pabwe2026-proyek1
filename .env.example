# Salin file ini menjadi .env lalu sesuaikan nilainya
# Perintah: cp .env.example .env

# Base URL REST API backend (tanpa garis miring di akhir).
# Hanya dipakai server frontend (loader, action, dan proxy /api). Browser tidak pernah memanggil backend langsung,
# jadi CORS backend tidak perlu mengizinkan domain publik frontend.
# Nilai dibaca saat build lewat $env/static/public, jadi harus berawalan PUBLIC_ dan perlu build ulang jika diubah.
PUBLIC_API_BASE_URL=http://localhost:3000/api
